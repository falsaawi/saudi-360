# The collected corpus is 3.1 GB and is reproducible from GASTAT by re-running
# the crawler, so it does not belong in version control. The catalogue that
# indexes it does belong: it is the record of what was collected and when.
#
# Note: git has no inline comments. A comment after a pattern on the same line
# becomes part of the pattern and the rule silently matches nothing.

# 1.29 GB of source spreadsheets and PDFs
data/files/

# 1.6 GB of parser output, rebuilt by run_parse_all.py
data/parsed/

# 260 MB warehouse, rebuilt by build_warehouse_all.py
data/*.duckdb
data/*.duckdb.wal

# crawl resume state and build logs, machine-specific
data/checkpoint.json
data/*.log

# phase-0 sample workbooks and scratch output
recon/samples/
recon/*.html
recon/inventory*.json
recon/releases.json

# Staging copy of the Parquet, rebuilt by build_parquet.py
dist/

# site/data/ is NOT ignored: the Query page reads the Parquet over HTTP range
# requests, and at 29 MB the whole set ships from Pages itself. That keeps the
# deployment to one service -- no bucket, no public bucket URL and no CORS --
# and Cloudflare's 25 MiB per-file limit has room to spare over the largest
# file at 17 MB. If the repository gets heavy, these move to R2 and the page
# is pointed at it by setting SAUDI360_DATA_BASE.

__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Wrangler, installed locally for deploys. Not part of the pipeline.
node_modules/
package-lock.json
