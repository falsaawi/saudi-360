# Cloudflare Pages reads this file to set response headers.
#
# The data payloads are rebuilt on every export, so they must revalidate rather
# than sit in a CDN or browser cache showing last month's figures. The geometry
# never changes, so it can be cached hard.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# The page itself changes whenever the site is redeployed.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Data: revalidate every load, but allow a 304 when nothing changed.
/app.json
  Cache-Control: public, max-age=0, must-revalidate
/geo.json
  Cache-Control: public, max-age=0, must-revalidate

# Administrative boundaries are fixed; cache them for a year.
/geo/*
  Cache-Control: public, max-age=31536000, immutable

# The Parquet the Query page reads.
#
# DuckDB-WASM asks for byte ranges, but Pages answers a ranged request for these
# with 200 and the whole file -- measured against the deployed site, not assumed.
# So the first use of the Query page downloads the set entire (~28 MB) and
# DuckDB works from that. Advertising Accept-Ranges here claimed a capability the
# server does not provide, which is worse than not claiming it.
#
# must-revalidate rather than a long max-age: the files are rebuilt whenever the
# warehouse is, and a revalidation that finds them unchanged costs one 304.
# Serving a stale warehouse would be the worse failure.
#
# Moving these to R2, which does serve partial content, is what makes the page
# fetch only the bytes a query touches. See DEPLOY.md.
/data/*
  Cache-Control: public, max-age=0, must-revalidate
